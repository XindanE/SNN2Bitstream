#ifndef RESET_NODE_H
#define RESET_NODE_H

{% if use_fixed %}
#if defined(__SYNTHESIS__) || defined(CSIM_APFIXED)
#include <ap_fixed.h>
#include <ap_int.h>
typedef ap_fixed<{{ fixed_config.width }}, {{ fixed_config.int }}, AP_TRN, AP_SAT> data_t;
typedef ap_uint<1> spike_t;
#else
#include <stdint.h>
typedef float data_t;
typedef uint8_t spike_t;
#endif
{% else %}
typedef float data_t;
{% endif %}

// Set reset vector from spikes: reset[i] = spk[i] * v_reset.
void reset_node(
    data_t *reset,
{% if use_fixed %}
    const spike_t *spk,
{% else %}
    const data_t *spk,
{% endif %}
    data_t v_reset,
    int len
);

#endif // RESET_NODE_H

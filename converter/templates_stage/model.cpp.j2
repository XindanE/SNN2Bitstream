// Top-level inference
{% if use_fixed %}
void inference(const input_t *input, output_t *output) {
{% else %}
void inference(const float *input, float *output) {
{% endif %}
    // HLS interface
{% if input_is_repeat %}
#pragma HLS INTERFACE m_axi port=input  offset=slave depth={{ input_dim_flat }}  bundle=input
{% else %}
#pragma HLS INTERFACE m_axi port=input  offset=slave depth={{ input_dim_flat * timesteps }}  bundle=input
{% endif %}
#pragma HLS INTERFACE m_axi port=output offset=slave depth={{ output_dim }}      bundle=output
#pragma HLS INTERFACE s_axilite port=input   bundle=control
#pragma HLS INTERFACE s_axilite port=output  bundle=control
#pragma HLS INTERFACE s_axilite port=return  bundle=control

    // LIF state kept static to avoid HLS stack overflow.
{% for lif in lif_layers %}
    static lif_mem_t_{{ lif.global_idx }} mem{{ lif.global_idx }}[{{ lif.out_dim }}];
{% if use_fixed %}
    static spike_t spk{{ lif.global_idx }}[{{ lif.out_dim }}];
{% else %}
    static data_t spk{{ lif.global_idx }}[{{ lif.out_dim }}];
{% endif %}
{% endfor %}

    // output accumulator
{% if use_fixed %}
    spike_acc_t acc[{{ output_dim }}];
{% else %}
    data_t acc[{{ output_dim }}];
{% endif %}

    // zero initialize
{% for lif in lif_layers %}
    INIT_MEM{{ lif.global_idx }}: for (int i = 0; i < {{ lif.out_dim }}; ++i) {
{% if use_pragma %}
{% if lif.out_dim <= 16 %}
#pragma HLS UNROLL
{% else %}
#pragma HLS UNROLL factor=16
{% endif %}
{% endif %}
        mem{{ lif.global_idx }}[i] = (lif_mem_t_{{ lif.global_idx }})0;
{% if use_fixed %}
        spk{{ lif.global_idx }}[i] = (spike_t)0;
{% else %}
        spk{{ lif.global_idx }}[i] = (data_t)0;
{% endif %}
    }
{% endfor %}
    INIT_ACC: for (int i = 0; i < {{ output_dim }}; ++i) {
{% if use_pragma %}
#pragma HLS UNROLL
{% endif %}
{% if use_fixed %}
        acc[i] = (spike_acc_t)0;
{% else %}
        acc[i] = (data_t)0;
{% endif %}
    }
{% if use_pragma %}
#pragma HLS ARRAY_PARTITION variable=acc complete dim=1
{% endif %}

{% if "dataflow" in opt_tags %}
    // DATAFLOW mode
    TIMESTEP_LOOP: for (int t = 0; t < TIMESTEPS; ++t) {
#pragma HLS DATAFLOW
{% if use_pragma %}
#pragma HLS LOOP_TRIPCOUNT min=1 max={{ timesteps }}
{% endif %}

        // PIPO buffers (inside loop for DATAFLOW)
{% if input_is_binary and use_fixed %}
        spike_t in_staging[INPUT_DIM_FLAT];
{% else %}
        data_t in_staging[INPUT_DIM_FLAT];
{% endif %}
{% for stage in stages %}
{% if use_fixed %}
{% if stage.output_is_spike is defined and stage.output_is_spike %}
        spike_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}];
{% else %}
        data_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}];
{% endif %}
{% else %}
        data_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}];
{% endif %}
{% endfor %}

        // load input frame
        load_input_frame(in_staging, input, t);

{% for stage in stages %}
{% if stage.stage_idx == 0 %}
        // Stage {{ stage.stage_idx + 1 }}
        timestep_stage{{ stage.stage_idx + 1 }}(in_staging, stage{{ stage.stage_idx + 1 }}_out, mem{{ stage.lif_layer_idx }}, spk{{ stage.lif_layer_idx }});
{% else %}
        // Stage {{ stage.stage_idx + 1 }}
        timestep_stage{{ stage.stage_idx + 1 }}(stage{{ stage.stage_idx }}_out, stage{{ stage.stage_idx + 1 }}_out, mem{{ stage.lif_layer_idx }}, spk{{ stage.lif_layer_idx }});
{% endif %}

{% endfor %}
        // accumulate output
        accumulate_output(acc, stage{{ stages | length }}_out);
    }
{% else %}
    // Sequential mode
    // input staging buffer
{% set staging = 'spike_staging' if (input_is_binary and use_fixed) else 'in_staging' %}
{% if input_is_binary and use_fixed %}
    spike_t {{ staging }}[INPUT_DIM_FLAT] = {(spike_t)0};
{% else %}
    data_t {{ staging }}[INPUT_DIM_FLAT] = {((data_t)0)};
{% endif %}

    // stage output buffers
{% for stage in stages %}
{% if use_fixed %}
{% if stage.output_is_spike is defined and stage.output_is_spike %}
    spike_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}] = {0};
{% else %}
    data_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}] = {0};
{% endif %}
{% else %}
    data_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}] = {0};
{% endif %}
{% if use_pragma %}
{% if stage.out_dim <= 16 %}
#pragma HLS ARRAY_PARTITION variable=stage{{ stage.stage_idx + 1 }}_out complete dim=1
{% else %}
#pragma HLS ARRAY_PARTITION variable=stage{{ stage.stage_idx + 1 }}_out cyclic factor={% if use_fixed %}{{ parallel_factor | default(8) }}{% else %}16{% endif %} dim=1
{% endif %}
{% endif %}
{% endfor %}

{% if input_is_repeat %}
    // repeat encoding: read input once
    for (int i = 0; i < INPUT_DIM_FLAT; ++i) {
{% if use_pragma %}
#pragma HLS PIPELINE II=1
{% endif %}
{% if input_is_binary and use_fixed %}
        {{ staging }}[i] = (spike_t)(input[i] != 0);
{% else %}
        {{ staging }}[i] = ((data_t)input[i]);
{% endif %}
    }
{% endif %}

    for (int t = 0; t < TIMESTEPS; ++t) {
{% if use_pragma %}
#pragma HLS LOOP_TRIPCOUNT min=1 max={{ timesteps }}
{% endif %}

{% if not input_is_repeat %}
{% if use_fixed %}
        const input_t *frame_in = input + (size_t)t * INPUT_DIM_FLAT;
{% else %}
        const float *frame_in = input + (size_t)t * INPUT_DIM_FLAT;
{% endif %}

{% if input_is_binary and use_fixed %}
        // rate encoding: binary to spike_t
        for (int i = 0; i < INPUT_DIM_FLAT; ++i) {
{% if use_pragma %}
#pragma HLS PIPELINE II=1
{% endif %}
            {{ staging }}[i] = (spike_t)(frame_in[i] != 0);
        }
{% else %}
        // input_t -> data_t
        for (int i = 0; i < INPUT_DIM_FLAT; ++i) {
{% if use_pragma %}
#pragma HLS PIPELINE II=1
{% endif %}
            {{ staging }}[i] = ((data_t)frame_in[i]);
        }
{% endif %}
{% endif %}

{% for stage in stages %}
{% if stage.stage_idx == 0 %}
        // Stage {{ stage.stage_idx + 1 }}
        timestep_stage{{ stage.stage_idx + 1 }}({{ staging }}, stage{{ stage.stage_idx + 1 }}_out, mem{{ stage.lif_layer_idx }}, spk{{ stage.lif_layer_idx }});
{% else %}
        // Stage {{ stage.stage_idx + 1 }}
        timestep_stage{{ stage.stage_idx + 1 }}(stage{{ stage.stage_idx }}_out, stage{{ stage.stage_idx + 1 }}_out, mem{{ stage.lif_layer_idx }}, spk{{ stage.lif_layer_idx }});
{% endif %}

{% endfor %}
        // Timestep accumulation
        for (int i = 0; i < {{ output_dim }}; ++i) {
{% if use_pragma %}
#pragma HLS UNROLL
{% endif %}
{% if use_fixed %}
            acc[i] += (spike_acc_t)stage{{ stages | length }}_out[i];
{% else %}
            acc[i] += stage{{ stages | length }}_out[i];
{% endif %}
        }
    }
{% endif %}

    // time average -> output
    for (int i = 0; i < {{ output_dim }}; ++i) {
{% if use_pragma %}
#pragma HLS UNROLL
{% endif %}
{% if use_fixed %}
        // Power-of-two time average (>> {{ output_shift }}) instead of /TIMESTEPS: same
        // argmax, no divide -> no DSP. Matches the streaming path's output shift.
        // data_t is only ap_fixed under synthesis or an ap_fixed csim; a plain float
        // build has no operator>>, so it divides by the same 2^{{ output_shift }}.
#if defined(__SYNTHESIS__) || defined(CSIM_APFIXED)
        output[i] = (output_t)(((data_t)acc[i]) >> {{ output_shift }});
#else
        output[i] = (output_t)(((data_t)acc[i]) / (data_t)(1 << {{ output_shift }}));
#endif
{% else %}
        output[i] = (float)(acc[i] / ((data_t)TIMESTEPS));
{% endif %}
    }
}

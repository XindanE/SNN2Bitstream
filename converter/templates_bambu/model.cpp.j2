// SNN inference model (Bambu backend), generated by snn2bitstream from {{ model_meta.ir_path }}.
// {{ model_meta.model_type | upper }}, {{ model_meta.training_method }}, config {{ model_meta.config_name }}, {{ model_meta.timesteps }} timesteps.
// Checkpoint, command line and accuracy are recorded in build_information.txt.
#include "model.h"
#include "reset_node.h"
#ifdef DEBUG_L1
#include <stdio.h>
#endif
#include <stddef.h>
#include <stdint.h>
{% for h in layer_headers %}
#include "{{ h }}"
{% endfor %}


typedef float data_t;

// LIF default parameters (from IR, fallback if missing) 
static const data_t LIF_BETA_DEFAULTS[{{ num_lif_layers if num_lif_layers > 0 else 1 }}] = {
{%- for beta in lif_betas -%}((data_t){{ beta }}){{ ", " if not loop.last }}{%- endfor -%}
{%- if lif_betas | length == 0 -%}((data_t)0.9){%- endif -%}
};
static const data_t LIF_VTH_DEFAULTS[{{ num_lif_layers if num_lif_layers > 0 else 1 }}] = {
{%- for vth in lif_vths -%}((data_t){{ vth }}){{ ", " if not loop.last }}{%- endfor -%}
{%- if lif_vths | length == 0 -%}((data_t)1.0){%- endif -%}
};

{% for stage in stages %}

////Pipeline Stage {{ stage.stage_idx + 1 }}: {{ stage.description }}////

void timestep_stage{{ stage.stage_idx + 1 }}(
    const data_t *in,
    data_t *out,
    data_t *mem{{ stage.lif_layer_idx }},
    data_t *spk{{ stage.lif_layer_idx }},
    data_t *reset{{ stage.lif_layer_idx }}
) {
{% for layer in stage.non_lif_layers %}
{% if layer.type in ["AvgPool2d", "MaxPool2d"] %}
    data_t buf_pool{{ layer.global_idx }}[{{ layer.out_dim }}] = {0};
{% elif layer.type == "DepthwiseConv2d" %}
    data_t buf_dw{{ layer.pair_idx }}[{{ layer.out_dim }}] = {0};
{% else %}
    data_t buf{{ layer.pair_idx }}[{{ layer.out_dim }}] = {0};
{% endif %}
{% endfor %}

{% set ns = namespace(prev_buf="in") %}
{% for layer in stage.all_layers %}
{% if layer.type == "Linear" %}
    fc_layer{{ layer.global_idx }}(buf{{ layer.pair_idx }}, {{ ns.prev_buf }});
{% set ns.prev_buf = "buf" ~ layer.pair_idx %}

#ifdef DEBUG_L1
    {
        float s = 0.0f;
        for (int di = 0; di < {{ layer.out_dim }}; ++di) {
            float v = (float){{ ns.prev_buf }}[di];
            s += (v >= 0 ? v : -v);
        }
        printf("[DBG] layer={{ layer.global_idx }} Linear L1=%e\n", s);
        fflush(stdout);
    }
#endif

{% elif layer.type == "DepthwiseConv2d" %}
    dw_conv_layer{{ layer.global_idx }}(buf_dw{{ layer.pair_idx }}, {{ ns.prev_buf }});
{% set ns.prev_buf = "buf_dw" ~ layer.pair_idx %}

#ifdef DEBUG_L1
    {
        float s = 0.0f;
        for (int di = 0; di < {{ layer.out_dim }}; ++di) {
            float v = (float){{ ns.prev_buf }}[di];
            s += (v >= 0 ? v : -v);
        }
        printf("[DBG] layer={{ layer.global_idx }} DepthwiseConv2d L1=%e\n", s);
        fflush(stdout);
    }
#endif

{% elif layer.type == "Conv2d" %}
    conv_layer{{ layer.global_idx }}(buf{{ layer.pair_idx }}, {{ ns.prev_buf }});
{% set ns.prev_buf = "buf" ~ layer.pair_idx %}

#ifdef DEBUG_L1
    {
        float s = 0.0f;
        for (int di = 0; di < {{ layer.out_dim }}; ++di) {
            float v = (float){{ ns.prev_buf }}[di];
            s += (v >= 0 ? v : -v);
        }
        printf("[DBG] layer={{ layer.global_idx }} Conv2d L1=%e\n", s);
        fflush(stdout);
    }
#endif

{% elif layer.type in ["AvgPool2d", "MaxPool2d"] %}
    pool_layer{{ layer.global_idx }}(buf_pool{{ layer.global_idx }}, {{ ns.prev_buf }});
{% set ns.prev_buf = "buf_pool" ~ layer.global_idx %}

#ifdef DEBUG_L1
    {
        float s = 0.0f;
        for (int di = 0; di < {{ layer.out_dim }}; ++di) {
            float v = (float){{ ns.prev_buf }}[di];
            s += (v >= 0 ? v : -v);
        }
        printf("[DBG] layer={{ layer.global_idx }} {{ layer.type }} L1=%e\n", s);
        fflush(stdout);
    }
#endif

{% elif layer.type == "LIF" %}
    neuron_layer{{ layer.global_idx }}(out, {{ ns.prev_buf }}, mem{{ layer.global_idx }}, spk{{ layer.global_idx }}, reset{{ layer.global_idx }}, LIF_BETA_DEFAULTS[{{ stage.lif_order_idx }}], LIF_VTH_DEFAULTS[{{ stage.lif_order_idx }}]);

#ifdef DEBUG_L1
    {
        float s = 0.0f;
        for (int di = 0; di < {{ layer.out_dim }}; ++di) {
            float v = (float)out[di];
            s += (v >= 0 ? v : -v);
        }
        printf("[DBG] layer={{ layer.global_idx }} LIF L1=%e\n", s);
        fflush(stdout);
    }
#endif

    reset_node(reset{{ layer.global_idx }}, spk{{ layer.global_idx }}, LIF_VTH_DEFAULTS[{{ stage.lif_order_idx }}], {{ layer.out_dim }});
{% endif %}
{% endfor %}
}

{% endfor %}

////Top-level inference function (timesteps as runtime parameter)////


void inference(const float *input, float *output) {
    // LIF layer state (persists across timesteps)
{% for lif in lif_layers %}
    data_t mem{{ lif.global_idx }}[{{ lif.out_dim }}];
    data_t spk{{ lif.global_idx }}[{{ lif.out_dim }}];
    data_t reset{{ lif.global_idx }}[{{ lif.out_dim }}];
{% endfor %}

    // Output accumulator
    data_t acc[{{ output_dim }}];

    // Explicit zero initialization 
{% for lif in lif_layers %}
    for (int i = 0; i < {{ lif.out_dim }}; ++i) {
        mem{{ lif.global_idx }}[i] = (data_t)0;
        spk{{ lif.global_idx }}[i] = (data_t)0;
        reset{{ lif.global_idx }}[i] = (data_t)0;
    }
{% endfor %}
    for (int i = 0; i < {{ output_dim }}; ++i) {
        acc[i] = (data_t)0;
    }

    // Input staging buffer
    data_t in_staging[INPUT_DIM_FLAT] = {((data_t)0)};

    // Stage output buffers
{% for stage in stages %}
    data_t stage{{ stage.stage_idx + 1 }}_out[{{ stage.out_dim }}] = {0};
{% endfor %}

    for (int t = 0; t < TIMESTEPS; ++t) {
        const float *frame_in = input + (size_t)t * INPUT_DIM_FLAT;

        // Input conversion: float -> data_t
        for (int i = 0; i < INPUT_DIM_FLAT; ++i) {
            in_staging[i] = ((data_t)frame_in[i]);
        }

{% for stage in stages %}
{% if stage.stage_idx == 0 %}
        // Stage {{ stage.stage_idx + 1 }}
        timestep_stage{{ stage.stage_idx + 1 }}(in_staging, stage{{ stage.stage_idx + 1 }}_out, mem{{ stage.lif_layer_idx }}, spk{{ stage.lif_layer_idx }}, reset{{ stage.lif_layer_idx }});
{% else %}
        // Stage {{ stage.stage_idx + 1 }}
        timestep_stage{{ stage.stage_idx + 1 }}(stage{{ stage.stage_idx }}_out, stage{{ stage.stage_idx + 1 }}_out, mem{{ stage.lif_layer_idx }}, spk{{ stage.lif_layer_idx }}, reset{{ stage.lif_layer_idx }});
{% endif %}

{% endfor %}
        // Timestep accumulation
        for (int i = 0; i < {{ output_dim }}; ++i) {
            acc[i] += stage{{ stages | length }}_out[i];
        }
    }

    // Time average -> output
    for (int i = 0; i < {{ output_dim }}; ++i) {
        output[i] = (float)(acc[i] / ((data_t)TIMESTEPS));
    }
}

#!/bin/bash
# Bambu HLS synthesis for {{ project_name }}, auto-generated by snn2bitstream. Run: bash run_bambu.sh
#
# Optimization tuning via env vars: BAMBU_OPT is the compiler optimization level (default -O2, options -O2..-O5).
# BAMBU_EXTRA passes extra Bambu flags (e.g. --pipelining,-p=inference or --speculative-sdc-scheduling).
#
# Requires PandA Bambu 2024.10 at /usr/local/bin/bambu and Vivado in PATH for the P&R backend.
# Bambu emits inference.v for a generic Xilinx device; the real target (xczu7ev/ZCU104) is set by Vivado in build_block_design.tcl.

set -e

BAMBU=${BAMBU:-/usr/local/bin/bambu}
BAMBU_OPT=${BAMBU_OPT:-"{{ bambu_opt if bambu_opt else '-O2' }}"}
BAMBU_EXTRA=${BAMBU_EXTRA:-"{{ bambu_extra if bambu_extra else '' }}"}
CLOCK_PERIOD=${CLOCK_PERIOD:-10}
XILINX_ROOT=${XILINX_ROOT:-/opt/Xilinx/Vivado/2020.2}

# Collect all source files
SOURCES="model.cpp \
{% for src in layer_sources %}
    {{ src }} \
{% endfor %}
    reset_node.cpp"

echo "=== Bambu HLS Synthesis ==="
echo "Project:      {{ project_name }}"
echo "Top function: inference"
echo "Clock period: ${CLOCK_PERIOD} ns"
echo "Xilinx root:  ${XILINX_ROOT}"
echo "BAMBU_OPT:    ${BAMBU_OPT}"
echo "BAMBU_EXTRA:  ${BAMBU_EXTRA:-"(none)"}"
echo ""

# Allow non-zero exit: --evaluation=CYCLES testbench generation may fail for pointer parameters, but synthesis and Verilog output still succeed.
BAMBU_RC=0
${BAMBU} ${BAMBU_OPT} -m64 \
    ${SOURCES} \
    --top-fname=inference \
    --clock-period=${CLOCK_PERIOD} \
    --channels-type=MEM_ACC_NN \
    --memory-allocation-policy=ALL_BRAM \
    --evaluation=CYCLES \
    --xilinx-root=${XILINX_ROOT} \
    -v2 \
    ${BAMBU_EXTRA} \
    "$@" || BAMBU_RC=$?

echo ""
if [ -f inference.v ]; then
    echo "=== Bambu synthesis completed ==="
    echo "Output: inference.v and HLS_output/ in current directory"
    # Extract the C++-mangled top module name for the AXI wrapper.
    grep '^module _Z9inference' inference.v | head -1 | sed 's/module \([^ (]*\).*/\1/' > .bambu_top_module
    echo "DUT module name: $(cat .bambu_top_module)"
    if [ $BAMBU_RC -ne 0 ]; then
        echo "WARNING: Bambu exited with code $BAMBU_RC (synthesis OK, evaluation/testbench may have failed)"
    fi
else
    echo "[Error] Bambu failed - no inference.v generated"
    exit 1
fi

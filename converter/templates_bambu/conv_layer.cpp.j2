// Convolutional Layer {{ index }}
#include "conv_layer{{ index }}.h"
#include "weights{{ layer.pair_idx }}.h"
#include "biases{{ layer.pair_idx }}.h"
#include <stddef.h>
#include <stdint.h>

{% if quant_weight %}
// INT8 quantized path.
typedef float data_t;
typedef int32_t w_t;
typedef int32_t acc_t;
{% else %}
typedef float data_t;
typedef float w_t;
typedef double acc_t;
{% endif %}

void conv_layer{{ index }}(
    data_t out[{{ layer.out_ch * layer.out_h * layer.out_w }}],
    const data_t in[{{ layer.in_ch * layer.in_h * layer.in_w }}]
) {
{% if quant_weight %}
    const float weight_scale = {{ quant_weight.scale }}f;
    const float bias_scale = {{ quant_bias.scale }}f;
    const int bias_zero_point = {{ quant_bias.zero_point }};
{% endif %}

    const int OC = {{ layer.out_ch }};
    const int IC = {{ layer.in_ch }};
    const int IH = {{ layer.in_h }};
    const int IW = {{ layer.in_w }};
    const int OH = {{ layer.out_h }};
    const int OW = {{ layer.out_w }};
    const int K  = {{ layer.kernel_size }};
    const int S  = {{ layer.stride }};
    const int P  = {{ layer.padding }};

    for (int oc = 0; oc < OC; oc++) {
        for (int oh = 0; oh < OH; oh++) {
            for (int ow = 0; ow < OW; ow++) {
{% if quant_weight %}
                acc_t acc = 0;
{% else %}
                acc_t acc = ((acc_t)(biases{{ layer.pair_idx }}[oc]));
{% endif %}
                for (int ic = 0; ic < IC; ic++) {
                    for (int kh = 0; kh < K; kh++) {
                        for (int kw = 0; kw < K; kw++) {
                            int ih = oh * S - P + kh;
                            int iw = ow * S - P + kw;
                            if (ih >= 0 && ih < IH && iw >= 0 && iw < IW) {
                                int in_idx = ic * IH * IW + ih * IW + iw;
{% if quant_weight %}
{% if input_is_spike %}
                                // Spike input: no multiply.
                                if (in[in_idx]) {
                                    acc += (acc_t)weights{{ layer.pair_idx }}[oc][ic][kh][kw];
                                }
{% else %}
                                // Data input: float * int8 weight into float acc.
                                acc += (acc_t)((float)weights{{ layer.pair_idx }}[oc][ic][kh][kw] * in[in_idx]);
{% endif %}
{% else %}
{% if input_is_spike %}
                                if (in[in_idx]) {
                                    acc += (acc_t)weights{{ layer.pair_idx }}[oc][ic][kh][kw];
                                }
{% else %}
                                w_t weight_val = weights{{ layer.pair_idx }}[oc][ic][kh][kw];
                                acc += (acc_t)weight_val * (acc_t)in[in_idx];
{% endif %}
{% endif %}
                            }
                        }
                    }
                }
{% if quant_weight %}
                float bias_dequant = (float)(biases{{ layer.pair_idx }}[oc] - bias_zero_point) * bias_scale;
                out[oc * OH * OW + oh * OW + ow] = (data_t)((float)acc * weight_scale) + bias_dequant;
{% else %}
                out[oc * OH * OW + oh * OW + ow] = (data_t)acc;
{% endif %}
            }
        }
    }
}

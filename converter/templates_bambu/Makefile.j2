# GCC software validation build for {{ project_name }} (Bambu backend). Auto-generated by snn2bitstream.
# Targets: make builds the test binary, make clean removes artifacts, make debug builds with DEBUG_L1 layer diagnostics.

CXX      = g++
CXXFLAGS = -std=c++11 -O2 -Wall -Wextra
LDFLAGS  = -lm

# Source files
SRCS = main_nmnist.c model.cpp \
{% for src in layer_sources %}
       {{ src }} \
{% endfor %}
       reset_node.cpp

TARGET = test

.PHONY: all clean debug

all: $(TARGET)

$(TARGET): $(SRCS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

debug: CXXFLAGS += -DDEBUG_L1
debug: $(TARGET)

clean:
	rm -f $(TARGET)
